  {"fieldname":"changed_by","label":"Changed By","fieldtype":"Link","options":"User","read_only":1},
  {"fieldname":"total_weekly_hours","label":"Weekly Hours","fieldtype":"Float","precision":2,"read_only":1,"in_list_view":1},
  {"fieldname":"change_summary","label":"Change Summary","fieldtype":"Small Text","read_only":1},
  {"fieldname":"schedule","label":"Schedule Snapshot","fieldtype":"Table","options":"Employee Work Schedule Revision Day","read_only":1}
 ],
 "permissions": [
  {"role":"HR User","read":1,"report":1,"export":1},
  {"role":"HR Manager","read":1,"report":1,"export":1,"print":1},
  {"role":"System Manager","read":1,"report":1,"export":1,"print":1}
 ]
}
