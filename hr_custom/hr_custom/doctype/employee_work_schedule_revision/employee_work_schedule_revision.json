  {"fieldname":"effective_from","label":"Effective From","fieldtype":"Date","reqd":1,"read_only":1,"in_list_view":1},
  {"fieldname":"effective_to","label":"Effective To","fieldtype":"Date","read_only":1,"in_list_view":1},
